# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# API keys and environment files
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Logs
logs/
*.log

# Pytest and coverage
.pytest_cache/
.coverage
htmlcov/

# Private conversation data
data/conversations/*.json
data/summaries/*.json

# Preserve empty directories
!data/conversations/.gitkeep
!data/summaries/.gitkeep

# Temporary files
*.tmp
*.bak